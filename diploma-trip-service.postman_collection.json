{
  "info": {
    "_postman_id": "d4d33db7-5d7b-4fd9-8fef-92c420fc5640",
    "name": "Diploma Trip Service",
    "description": "Trip service API through diploma-gateway (`/api/trip/**` \u2192 trip-service).\n\nTo bypass the gateway, set `baseUrl` to `{{directUrl}}/api/trip`.\n\nFlow: **Get categories** \u2192 **Autocomplete locations** \u2192 **Create trip** \u2192 **Get trip details**.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Get categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "categories"
              ]
            },
            "description": "All trip categories. Fills `categoryIds` with the first two ids if it is empty."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test(\"Returns categories\", () => pm.expect(data).to.be.an(\"array\").that.is.not.empty);",
                  "if (!pm.collectionVariables.get(\"categoryIds\") && data.length) {",
                  "    pm.collectionVariables.set(\"categoryIds\", data.slice(0, 2).map(c => c.id).join(\",\"));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Autocomplete locations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/locations/autocomplete?userInput={{locationQuery}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "locations",
                "autocomplete"
              ],
              "query": [
                {
                  "key": "userInput",
                  "value": "{{locationQuery}}"
                }
              ]
            },
            "description": "Location suggestions from Google Places. Saves the first suggestion's `googlePlaceId` for **Create trip**."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test(\"Returns suggestions\", () => pm.expect(data).to.be.an(\"array\"));",
                  "if (data.length) {",
                  "    pm.collectionVariables.set(\"googlePlaceId\", data[0].googlePlaceId);",
                  "    console.log(`googlePlaceId = ${data[0].googlePlaceId} (${data[0].location})`);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Trips",
      "item": [
        {
          "name": "Create trip",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/trips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "trips"
              ]
            },
            "description": "Creates a trip. Run **Autocomplete locations** first to fill `googlePlaceId`. Saves the new trip id to `tripId` (shared with the plan service collection).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"title\": \"Weekend in Warsaw\",\n  \"startDate\": \"2027-05-14\",\n  \"endDate\": \"2027-05-16\",\n  \"budgetAmount\": 500.00,\n  \"googlePlaceId\": \"{{googlePlaceId}}\",\n  \"categoryIds\": [{{categoryIds}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "if (data && data.id) {",
                  "    pm.collectionVariables.set(\"tripId\", data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List user trips",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/trips?userId={{userId}}&search=Wars&page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "trips"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                },
                {
                  "key": "search",
                  "value": "Wars"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": "User trips, paged. `search` is optional (max 100 chars), `size` is 1-50."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns a page\", () => pm.expect(pm.response.json().data.content).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get trip details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/trips/{{tripId}}?userId={{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "trips",
                "{{tripId}}"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            },
            "description": "Trip with location and categories."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "directUrl",
      "value": "http://localhost:9091",
      "type": "string"
    },
    {
      "key": "baseUrl",
      "value": "{{gatewayUrl}}/api/trip",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "tripId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "locationQuery",
      "value": "Wars",
      "type": "string"
    },
    {
      "key": "googlePlaceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryIds",
      "value": "1",
      "type": "string"
    }
  ]
}
